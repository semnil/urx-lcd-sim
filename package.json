{
  "name": "urx-lcd-sim",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "license": "MIT",
  "type": "module",
  "description": "Unofficial operation simulator for the YAMAHA URX series 4.3-inch LCD touch screen",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-screens": "node scripts/extract-ug-screens.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
