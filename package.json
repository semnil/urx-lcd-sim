{
  "name": "urx-lcd-sim",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Unofficial operation simulator for the YAMAHA URX series 4.3-inch LCD touch screen",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-screens": "node scripts/extract-ug-screens.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
